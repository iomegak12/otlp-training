# ============================================================================================
# TradeNova Day 3 lab settings. Edit the REGISTRY line before running anything.
# Every script in this folder reads this file.
# ============================================================================================

# Where the five TradeNova images are pushed and pulled from (run `docker login` first).
#   Docker Hub:  REGISTRY=docker.io/<your-docker-hub-user>
#   GitHub:      REGISTRY=ghcr.io/<your-github-user>   (make the packages public, or add a pull secret)
REGISTRY=docker.io/iomega
IMAGE_TAG=3.0.0

# Multipass virtual machines (instructor cluster: 1 control plane + 3 workers)
VM_PREFIX=tn
VM_IMAGE=24.04
CP_CPUS=2
CP_MEMORY=4G
CP_DISK=30G
WORKER_CPUS=4
WORKER_MEMORY=12G
WORKER_DISK=40G
WORKER_COUNT=3

# kubeconfig written by 00-cluster/install-k3s.sh
KUBECONFIG_FILE=$HOME/.kube/tradenova-day3.yaml

# Participants' single-node light kit: set to 1 (see participant-kit/README-participants.md).
# Uses one VM, one Kafka broker, smaller backends and one replica per application.
LIGHT_MODE=0
LIGHT_VM_CPUS=4
LIGHT_VM_MEMORY=8G
LIGHT_VM_DISK=30G

# Token that applications must present to the agent Collector (Lab 4)
INGEST_TOKEN=tradenova-day3-ingest-token
