# quote-service (Python, Flask) - OpenTelemetry configuration
#
# Lab B: the container now starts with
#   opentelemetry-instrument python app.py
QUOTE_ZERO_CODE=true

OTEL_SERVICE_NAME=quote-svc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# Lab B: do not trace the container health check (/health every 5 seconds)
OTEL_PYTHON_FLASK_EXCLUDED_URLS=health
