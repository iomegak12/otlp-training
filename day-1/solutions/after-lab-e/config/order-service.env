# order-service (Java, Spring Boot) - OpenTelemetry configuration
#
# The Java agent is attached with JAVA_TOOL_OPTIONS.
JAVA_TOOL_OPTIONS=-javaagent:/otel/opentelemetry-javaagent.jar
OTEL_JAVAAGENT_ENABLED=true

# Lab E: standard service name and resource attributes, the same pattern for every service
OTEL_SERVICE_NAME=order-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tradenova,service.version=1.0.0,deployment.environment.name=training

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=10000

# Lab B: stop tracing the MarketHeartbeat @Scheduled job (about 300 traces per minute of noise)
OTEL_INSTRUMENTATION_SPRING_SCHEDULING_ENABLED=false
