# settlement-service (Python) - OpenTelemetry configuration
#
# This service was instrumented by hand with the OpenTelemetry SDK
# (see services/settlement-service/telemetry.py), so it emits telemetry from the start.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Lab E: standard service name and resource attributes, read by Resource.create() in telemetry.py
OTEL_SERVICE_NAME=settlement-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tradenova,service.version=1.0.0,deployment.environment.name=training
