# quote-service (Python, Flask) - OpenTelemetry configuration
#
# Lab B: the container starts with
#   opentelemetry-instrument python app.py
QUOTE_ZERO_CODE=true

# Lab E: standard service name and resource attributes, the same pattern for every service
OTEL_SERVICE_NAME=quote-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=tradenova,service.version=1.0.0,deployment.environment.name=training

# Lab E: emit the stable HTTP semantic conventions (http.request.method,
# http.response.status_code, http.server.request.duration in seconds), the same names
# the Java agent uses. "http/dup" would emit old and new names side by side.
OTEL_SEMCONV_STABILITY_OPT_IN=http

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=10000

# Lab B: do not trace the container health check (/health every 5 seconds)
OTEL_PYTHON_FLASK_EXCLUDED_URLS=health
