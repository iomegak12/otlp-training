# order-service (Java, Spring Boot) - OpenTelemetry configuration
#
# The Java agent is attached with JAVA_TOOL_OPTIONS, but it is switched off.
# Lab B: change OTEL_JAVAAGENT_ENABLED to true.
JAVA_TOOL_OPTIONS=-javaagent:/otel/opentelemetry-javaagent.jar
OTEL_JAVAAGENT_ENABLED=false

OTEL_SERVICE_NAME=OrderService
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_METRIC_EXPORT_INTERVAL=10000

OTEL_INSTRUMENTATION_SPRING_SCHEDULING_ENABLED=false
