# TradeNova Day 2 lab settings. After changing a value: docker compose up -d <service>

# Requests per second sent by the load generator
LOADGEN_RPS=5

# Collector agent: Go memory limit (scenario 2). Empty = not set (starting state).
AGENT_GOMEMLIMIT=220MiB

# eod-reconciliation batch job (scenario 6)
#   EOD_PUSH_ENABLED   false = the job's results are lost (starting state); true = pushed to the Pushgateway
#   EOD_FAILURE_MODE   random | always | never
EOD_PUSH_ENABLED=true
EOD_FAILURE_MODE=random
EOD_INTERVAL_SECONDS=90
